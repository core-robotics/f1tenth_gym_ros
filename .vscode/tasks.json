{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "colcon: build (symlink)",
      "type": "shell",
      "command": "/bin/bash",
      "args": [
        "-lc",
        "source /opt/ros/foxy/setup.bash && colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Debug"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": ["$gcc", "$clike"]
    }
  ]
}